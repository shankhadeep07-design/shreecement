<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Event Reminder</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <style>
    /* RESET */
    html,body { margin:0; padding:0; background:#f4f6f8; }
    img { border:0; max-width:100%; display:block; }
    table { border-collapse:collapse; }
    a { text-decoration:none; }

    /* WRAPPER */
    .email-wrapper { width:100%; background:#f4f6f8; padding:32px 0; }
    .email-content { max-width:700px; margin:0 auto; background:#ffffff; border-radius:12px; overflow:hidden; box-shadow:0 4px 16px rgba(0,0,0,0.1); }

    /* HEADER */
    .email-header { background:linear-gradient(90deg,#0066ff,#00c3ff); padding:24px; text-align:center; position:relative; }
    .brand { font-size:24px; font-weight:700; color:#ffffff; letter-spacing:0.5px; display:block; margin-top:10px; }
    .logo { width:80px; margin:0 auto; display:block; }

    /* Simple shimmer animation */
    @keyframes shimmer {
      0% { background-position:-500px 0; }
      100% { background-position:500px 0; }
    }
    .shimmer {
      background:linear-gradient(to right,#ffffff33 0%,#ffffff99 50%,#ffffff33 100%);
      background-size:1000px 100%;
      animation:shimmer 2s infinite;
      -webkit-background-clip:text;
      -webkit-text-fill-color:transparent;
    }

    /* BODY */
    .email-body { padding:32px; font-family:'Segoe UI',Arial,sans-serif; color:#444; font-size:16px; line-height:1.6; }
    .hero { text-align:center; padding:24px; border-radius:10px; background:#f0f8ff; border:1px solid #dceeff; margin-bottom:24px; }
    .event-title { font-size:24px; font-weight:700; color:#0d1b2a; margin:0 0 8px; }
    .event-meta { font-size:15px; color:#555; margin:6px 0; }

    .details-table { width:100%; margin:20px 0; }
    .details-table td { padding:10px 0; }
    .label { width:120px; color:#6b7a80; font-weight:600; font-size:14px; }
    .value { color:#2b2f33; font-size:15px; }

    .btn { display:inline-block; background:linear-gradient(90deg,#0066ff,#00c3ff); color:#fff; padding:14px 28px; border-radius:8px; font-size:15px; font-weight:600; margin-top:20px; box-shadow:0 4px 8px rgba(0,0,0,0.2); transition:transform 0.2s ease,box-shadow 0.2s ease; }
    .btn:hover { transform:scale(1.05); box-shadow:0 6px 12px rgba(0,0,0,0.25); }

    .note { margin:24px 0; padding:14px; background:#fff7e6; border:1px solid #ffd28a; border-radius:6px; font-size:14px; color:#7a4b00; }

    /* FOOTER */
    .email-footer { background:#fafbfc; padding:20px 28px; text-align:center; font-size:13px; color:#7b8a90; }
    .email-footer a { color:#0066ff; }

    /* Responsive */
    @media only screen and (max-width:520px) {
      .email-body { padding:20px; }
      .label { display:block; width:100%; margin-bottom:4px; }
      .details-table td { display:block; width:100%; }
    }
  </style>
</head>
<body>
  <table class="email-wrapper" width="100%" role="presentation">
    <tr>
      <td align="center">
        <table class="email-content" width="100%" role="presentation">

          <!-- HEADER -->
          <tr>
            <td class="email-header" style="text-align:center; padding:24px; background:linear-gradient(90deg,#0066ff,#00b5f5);">
                <img 
                src="https://www.coromandel.biz/wp-content/uploads/2025/04/CIL-logo-2048x878.png" 
                alt="Coromandel Logo" 
                width="200" 
                style="display:block; margin:auto; border:0;"
                >
                <span style="font-size:24px; font-weight:700; color:#fff; display:block; margin-top:8px;">
                Coromandel Events
                </span>
            </td>
            </tr>


          <!-- BODY -->
          <tr>
            <td class="email-body">
              <div class="hero">
                <p class="event-title">🎉 Reminder: {{eventName}}</p>
                <p class="event-meta">📅 Starts on <strong>{{startDate}}</strong></p>
                {{#if eventLocation}}
                <p class="event-meta">📍 Location: <strong>{{eventLocation}}</strong></p>
                {{/if}}
              </div>

              <p>Hi,</p>
              <p>We’re thrilled to remind you about your upcoming event! Here are the details:</p>

              <table class="details-table" role="presentation">
                <tr>
                  <td class="label">Event</td>
                  <td class="value">{{eventName}}</td>
                </tr>
                <tr>
                  <td class="label">When</td>
                  <td class="value">{{startDate}}</td>
                </tr>
                {{#if location}}
                <tr>
                  <td class="label">Where</td>
                  <td class="value">{{location}}</td>
                </tr>
                {{/if}}
                {{#if eventDetails}}
                <tr>
                  <td class="label">Details</td>
                  <td class="value">{{eventDetails}}</td>
                </tr>
                {{/if}}
              </table>

              {{#if rsvpLink}}
              <div style="text-align:center;">
                <a class="btn" href="{{rsvpLink}}">✅ Confirm / View RSVP</a>
              </div>
              {{/if}}

              {{#if activity_details}}
              <div class="note"><strong>Note:</strong> {{activity_details}}</div>
              {{/if}}

              <p>If your plans have changed, please update your status in the App or Web.</p>

              <hr style="border:none;border-top:1px solid #eaecef;margin:28px 0;" />

              <p><strong>Organizer:</strong> {{hr_person_name}}</p>
              {{#if hr_person_phone_no}}
              <p>Contact: <a href="tel:{{hr_person_phone_no}}">{{hr_person_phone_no}}</a></p>
              {{/if}}

              <p>Thanks,<br/>The Coromandel Team</p>
            </td>
          </tr>

          <!-- FOOTER -->
          <tr>
            <td class="email-footer">
              <p>You received this email because you signed up for <strong>{{eventName}}</strong>.</p>
              <p>Coromandel · <a href="mailto:coromandel@gmail.com">coromandel@gmail.com</a></p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
